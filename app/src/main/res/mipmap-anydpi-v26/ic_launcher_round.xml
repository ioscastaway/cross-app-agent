<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon. The launcher masks these layers to whatever shape the device uses, so only the
    middle 66dp of the 108dp canvas is guaranteed visible; the hand is sized to sit inside it.
    The monochrome layer is what Android 13+ themed icons tint.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
